+    const typeLabel=({'1':'국가산업단지','2':'일반산업단지','3':'도시첨단산업단지','4':'농공단지'})[danType]||'산업단지';
+    let sourceArea=0;try{sourceArea=Math.max(0,turf.area(turf.feature(f.geometry)));}catch(e){}
