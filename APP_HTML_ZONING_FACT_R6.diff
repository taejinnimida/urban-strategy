+  const primary=rows[0]?.name||planningAnalysis.primaryZoning||'';
+  const known=!!planningAnalysis.loaded&&!layerError&&rows.length>0&&!!primary;
+  return {known,count:rows.length,primary,primary_pct:rows[0]?.pct??planningAnalysis.primaryRatio??null,layer_error:layerError,rows};
+}
+async function analyzePlanningZoningCritical(){
+  if(!activeGeometry)throw new Error('용도지역 검토 구역계 없음');
+  let snap=planningZoningCriticalSnapshot();
+  if(snap.known)return {known:true,count:snap.count,primary:snap.primary,primary_pct:snap.primary_pct,source:'도시계획 GIS 1차 결과'};
+
+  const spec=PLANNING_LAYER_SPECS.find(x=>x.id==='LT_C_UQ111');
+  if(!spec)throw new Error('LT_C_UQ111 용도지역 레이어 정의 없음');
+  const zoneFeature=turf.feature(activeGeometry);
+  const result=await fetchPlanningSpec(spec,activeGeometry);
+
+  // 다른 도시계획 FACT는 보존하고 용도지역만 독립 재확인한다.
+  planningAnalysis.zoning=[];
+  planningAnalysis.primaryZoning='';planningAnalysis.primaryZoningDisplay='';planningAnalysis.primaryRatio=null;planningAnalysis.zoningMixed=false;
+  planningAnalysis.zoningOverlapArea=0;planningAnalysis.zoningUnknown=0;planningAnalysis.zoningRawFeatureCount=0;planningAnalysis.zoningUnionFeatureCount=0;
+  planningAnalysis.errors=(planningAnalysis.errors||[]).filter(x=>x.id!=='LT_C_UQ111');
+  if(result?.error){
+    planningAnalysis.errors.push({id:'LT_C_UQ111',error:String(result.error)});
+  }else{
+    ingestPlanningResults([result],zoneFeature);
+  }
+  const total=Math.max(1,Number(document.getElementById('area_m2')?.value)||0);
+  const rows=planningZoningRows(total);
+  if(rows.length){
+    const top=rows[0];planningAnalysis.primaryZoning=top.name||'';planningAnalysis.primaryZoningDisplay=top.name||'';planningAnalysis.primaryRatio=top.pct;planningAnalysis.zoningMixed=rows.length>1&&(top.pct==null||top.pct<95);
+  }
+  planningAnalysis.loaded=true;planningAnalysis.loading=false;
+  renderPlanningGIS();syncPlanningZoningToInputs();updateSiteStatusCard();renderZoningSpatialStatus();refreshMainMapReviewData();
