+    marker = f"function {name}("
+    start = src.find(marker)
+    if start < 0:
+        return ""
+    brace = src.find("{", start)
+    depth = 0
+    quote = None
+    escape = False
+    for i in range(brace, len(src)):
+        ch = src[i]
+        if quote:
